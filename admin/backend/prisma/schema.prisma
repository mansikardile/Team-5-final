generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  SPOC
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(ADMIN)
  company      String?  @default("SevaSahayog") // If SPOC, corporate partner company name e.g. Mastercard
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  events       Event[]  @relation("AdminEvents")

  @@map("admins")
}

model StudentUser {
  id                 String              @id @default(cuid())
  fullName           String
  email              String              @unique
  passwordHash       String?
  phone              String?
  collegeName        String?             // Corporate Partner / Company (e.g. Mastercard, Barclays, TCS, Cummins)
  verificationStatus String              @default("PENDING_SPOC_VERIFICATION") // PENDING_SPOC_VERIFICATION | VERIFIED | REJECTED
  verifiedById       String?
  otpCode            String?
  otpExpiresAt       DateTime?
  isProfileComplete  Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  volunteerFeedbacks VolunteerFeedback[]

  @@index([email])
  @@map("student_users")
}

model Event {
  id                 String              @id @default(cuid())
  code               String              @unique
  title              String
  collegeName        String              // Corporate Partner / Location
  location           String?
  eventDate          DateTime
  description        String?
  aiExecutiveSummary String?             @db.Text
  isActive           Boolean             @default(true)
  createdById        String?
  createdBy          Admin?              @relation("AdminEvents", fields: [createdById], references: [id])
  volunteerFeedbacks VolunteerFeedback[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@map("events")
}

model VolunteerFeedback {
  id                   String      @id @default(cuid())
  activityId           String
  activity             Event       @relation(fields: [activityId], references: [id], onDelete: Cascade)
  userId               String
  user                 StudentUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  language             String      @default("en") // en | hi | mr
  experience           String      @db.Text
  translatedExperience String?     @db.Text
  rating               Int         // 1 to 5
  suggestion           String?     @db.Text
  translatedSuggestion String?     @db.Text
  createdAt            DateTime    @default(now())

  @@unique([userId, activityId])
  @@index([activityId])
  @@index([userId])
  @@map("volunteer_feedbacks")
}
